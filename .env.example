# Server only. Never use EXPO_PUBLIC_ for a secret. Do not commit real values.
SARATHI_AI_ENABLED=false
OPENAI_API_KEY=
# Or use Gemini instead: set GEMINI_API_KEY (takes priority) and a Gemini model name in SARATHI_AI_MODEL.
GEMINI_API_KEY=
# Pick a model that supports Responses API structured outputs in your account.
SARATHI_AI_MODEL=
SARATHI_ALLOWED_ORIGINS=http://localhost:8081,https://sarathi-wine.vercel.app
# Only for native apps or a separate API host; public endpoint URL, NOT a key.
# EXPO_PUBLIC_ASSISTANT_API_URL=https://your-api-host.example/api/assistant
